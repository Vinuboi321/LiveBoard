# Copy to .env.local for local development, and add the same names in Vercel → Project → Settings → Environment Variables.

# --- Browser (public; safe to expose) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server only (used by /api/marker; never prefix these with VITE_) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional: defaults to claude-sonnet-5-5. A Haiku model is cheaper for a large free tier.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Required for AI: the server checks every request's sign-in and usage with these. Without them AI stays off.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Limits, enforced atomically in the database (begin_ai_request). The database also caps them, so a typo can't remove them.
AI_DAILY_LIMIT=60
AI_PER_MINUTE_LIMIT=8
AI_GLOBAL_DAILY_LIMIT=5000
# Emergency switch: set to true and redeploy (no code change) to turn AI off.
# AI_DISABLED=true
# Local `vercel dev` only: allow AI without signing in. Ignored on preview and production deploys.
# ALLOW_ANONYMOUS_AI=true
