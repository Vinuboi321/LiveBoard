{
  "name": "liveboard",
  "version": "0.1.0",
  "description": "LiveBoard: a marker-first study notes app",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:synctest": "VITE_SUPABASE_URL=http://sb.test VITE_SUPABASE_ANON_KEY=test-anon-key vite build --outDir dist-synctest",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-all.cjs",
    "test:api": "node tests/api.cjs",
    "test:sql": "bash tests/sql/run.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "dexie": "^4.0.10",
    "dompurify": "3.4.17",
    "marked": "^14.1.4",
    "mathjs": "15.2.0",
    "mermaid": "11.17.2",
    "pdfjs-dist": "^4.8.69"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "5.6.3",
    "vite": "6.4.5",
    "vite-plugin-pwa": "2.0.0"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "katex": "^0.18.2"
  }
}
